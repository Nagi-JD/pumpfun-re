#!/usr/bin/env python3
# Report the macOS arm64 host to cargo (version + host cfg) so cargo derives the
# same -C metadata / platform-dependency graph as the Round34 macOS build.
# Compilation itself always runs the real Linux v1.44 rustc unchanged.
import os, sys, subprocess
REAL = os.path.expanduser('~/.cache/solana/v1.44/platform-tools/rust/bin/rustc')
H = 'aarch64-apple-darwin'
a = sys.argv[1:]
if a == ['-vV']:
    o = subprocess.run([REAL, '-vV'], capture_output=True, text=True).stdout
    sys.stdout.write(''.join(('host: ' + H + '\n') if l.startswith('host: ') else l for l in o.splitlines(True)))
    sys.exit(0)
if '--print=cfg' in a and '--target' not in a and not any(x.startswith('--target=') for x in a):
    p = subprocess.run([REAL] + a, capture_output=True, text=True)
    if p.returncode:
        sys.stderr.write(p.stderr); sys.exit(p.returncode)
    lines = p.stdout.splitlines(True)
    i = len(lines) - 1 - lines[::-1].index('___\n')
    fake = subprocess.run([REAL, '--print=cfg', '--target', H], capture_output=True, text=True, check=True).stdout
    sys.stdout.write(''.join(lines[:i + 1]) + fake)
    sys.stderr.write(p.stderr)
    sys.exit(0)
os.execv(REAL, [REAL] + a)
