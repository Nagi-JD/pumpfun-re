+use crate::*;
+use crate::trade::native_transfer_fee::Fee;
+
+#[inline(never)]
+pub fn calculate_fee(fee:&Option<Fee>,amount:u64)->Result<u64>{
+ match *fee {
+  None=>Ok(0),
+  Some(fee)=>fee.calculate_fee(amount).ok_or_else(||error!(PumpError::Overflow)),
+ }
+}
