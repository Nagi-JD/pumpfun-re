+impl borsh::BorshSerialize for Pk8 {
+    #[inline(never)]
+    fn serialize<W: borsh::maybestd::io::Write>(&self, writer: &mut W) -> borsh::maybestd::io::Result<()> {
+        for pk in &self.0 {
+            borsh::BorshSerialize::serialize(pk, writer)?;
+        }
+        Ok(())
+    }
