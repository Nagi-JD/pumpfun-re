+#[inline(never)]
+pub fn apply_buy(this:&mut trade_types::BondingCurve,amount:u64,quote:u64)->Result<()>{
+  this.virtual_token_reserves=this.virtual_token_reserves.checked_sub(amount).ok_or_else(||error!(PumpError::Overflow))?;
 
 
 
 
+  this.real_token_reserves=this.real_token_reserves.checked_sub(amount).ok_or_else(||error!(PumpError::Overflow))?;
 
 
 
 
+  this.virtual_quote_reserves=this.virtual_quote_reserves.checked_add(quote).ok_or_else(||error!(PumpError::Overflow))?;
 
 
 
 
+  this.real_quote_reserves=this.real_quote_reserves.checked_add(quote).ok_or_else(||error!(PumpError::Overflow))?;
+  Ok(())
+}
 
 
 
 
+#[inline(never)]
+pub fn apply_sell(this:&mut trade_types::BondingCurve,amount:u64,quote:u64)->Result<()>{
+  this.virtual_token_reserves=this.virtual_token_reserves.checked_add(amount).ok_or_else(||error!(PumpError::Overflow))?;
 
 
 
 
+  this.real_token_reserves=this.real_token_reserves.checked_add(amount).ok_or_else(||error!(PumpError::Overflow))?;
 
 
 
 
+  this.virtual_quote_reserves=this.virtual_quote_reserves.checked_sub(quote).ok_or_else(||error!(PumpError::Overflow))?;
 
 
 
 
+  this.real_quote_reserves=this.real_quote_reserves.checked_sub(quote).ok_or_else(||error!(PumpError::Overflow))?;
+  Ok(())
+}
 
 
 
+#[inline(never)]
+pub fn accrue_fees(this:&mut trade_types::BondingCurve,global:&Global,protocol_fee:u64,creator_fee:u64)->Result<u64>{
+  let (buyback_fee,retained)=if this.is_mayhem_mode {(0,protocol_fee)}else{
+   let buyback_fee=u64::try_from(global.buyback_basis_points as u128*protocol_fee as u128/10000).expect("buyback fee is at most protocol_fee");
+   let retained=protocol_fee.checked_sub(buyback_fee).expect("buyback_fee never exceeds protocol_fee");
+   (buyback_fee,retained)};
 
 
 
+  this.protocol_fees=this.protocol_fees.checked_add(retained).ok_or_else(||error!(PumpError::Overflow))?;
 
 
 
